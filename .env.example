# Copy to .env and adjust as needed. All variables are prefixed SPDA_
# (see backend/app/core/config.py). Nothing here is a secret in Phase 1;
# Phase 3 will add DB/API-key style secrets to this file.

# --- Embeddings ---
SPDA_EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
# Alternative: sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
SPDA_EMBEDDING_DEVICE=cpu
SPDA_EMBEDDING_BATCH_SIZE=32

# --- Chunking ---
SPDA_MIN_CHUNK_WORDS=20
SPDA_MAX_CHUNK_WORDS=80
SPDA_CHUNK_OVERLAP_SENTENCES=1

# --- Retrieval / analysis (Phase 2+) ---
SPDA_DEFAULT_TOP_K=5
SPDA_SIMILARITY_THRESHOLD=0.75

# --- File handling ---
SPDA_MAX_UPLOAD_SIZE_MB=25

# --- Storage (Phase 2/3+) ---
SPDA_DATABASE_URL=sqlite:///./data/plagiarism.db
SPDA_FAISS_INDEX_DIR=./data/faiss_index
